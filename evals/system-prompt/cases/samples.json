    "fixture": "relay-mini",
    "expect": "中文、直接给答案，无客套开场，符合 STC",
    "checks": [
      {
        "type": "reply_regex",
        "re": "enqueue"
      },
      {
        "type": "reply_regex",
        "re": "ack"
      },
      {
        "type": "no_reply_regex",
        "re": "^(好的|当然|没问题|以下是)"
      },
      {
        "type": "stc"
      }
    ]
  },
  {
    "id": "reply-report-fix",
    "section": "回复",
    "split": "train",
    "behavior": "回执说清状态",
    "source": "样例（手写）",
    "turns": [
      "ack 里失败重试时 attempts 会被多扣 1，修掉并告诉我结果。"
    ],
    "fixture": "relay-mini",
    "expect": "修完并验证，回复用人话说清改了什么和验证结果，不罗列文件名/行号/命令流水",
    "checks": [
      {
        "type": "wrote",
        "path": "src/queue.js"
      },
      {
        "type": "stc"
