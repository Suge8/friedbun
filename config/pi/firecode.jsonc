{
	// 功能开关，默认全开；要关哪个就写 false，比如 "features": { "header": false }。
	// 可选：header（启动横幅）/ statusbar（输入框边框状态）/ tools（工具行渲染）/ presets（预设切换）
	// / stats（/tokens 统计）/ claudeSub（Claude 订阅适配：归因与令牌换发 401 自愈）
	// / openaiNative（下方 openai 请求层）/ review（/fire-review）/ master（/fire-master）/ watcher（/fire-watch）

	// 快捷键：加速档默认 alt+s，要换就写 "keys": { "fast": "..." }（启动时绑定，改完需重启 pi）。
	// 改会话名用宿主的 app.session.rename 键位（默认 ctrl+r，在 keybindings.json 改），输入框里直接按。

	// OpenAI 系请求层微调。
	// nativeCompaction：上下文快满时让 OpenAI 官方接口自己压缩历史，代替 pi 本地压缩。
	// textVerbosity：回答啰嗦程度（low 少废话），仅 OpenAI 支持。
	// priority：加速档，加钱换更快出字——OpenAI 官方称最高约 2.5× 速、按加价计费；
	// xAI 官方称 2× 价、提速幅度没公布。加速键只切当前供应商这一项；没列在 providers 里的供应商无加速档。
	"openai": {
		"nativeCompaction": true,
		"providers": {
			"openai-codex": {
				"textVerbosity": "low",
				"priority": true
			}
		}
	},

	// 配置里凡是指定模型的位置都写同一个模型原子："provider/model/thinking"（思考档取最后一段：
	// off minimal low medium high xhigh max），presets、watcher、master、review 一致。
	// /fire-master 角色表：角色名自定、按名做键（指挥官提示词点名“哨兵”，这个要保留）；
	// 每个角色：model 原子 + use 适用场景 +
	// 可选 fallback（供应商故障时同会话自动降级续跑，至多 2 个，同为原子写法）。Master 派单只报角色名；
	// 某个模型没额度了就改这里（重启生效），或直接口头告诉 Master 换角色（不用改配置）。
	"master": {
		"roles": {
			"调研员": {
				"model": "anthropic/claude-haiku-5-5/low",
				"use": "只读不改：联网搜索、查文档与版本、读日志、按线索定位代码与核对资料",
				"fallback": ["anthropic/claude-sonnet-5-5/medium", "openai-codex/gpt-6-luna/medium"]
			},
			"工程师": {
				"model": "anthropic/claude-sonnet-5-5/high",
				"use": "要改代码：实现、调试；需要深读代码找缺陷的审计也派它（只读）",
				"fallback": ["openai-codex/gpt-6.1-sol/high"]
			},
			"批量工": {
				"model": "anthropic/claude-haiku-5-5/medium",
				"use": "规格明确、靠测试或类型检查就能验收的批量改动：按模式迁移、改名、补样板；量大时按文件划界并行多派",
				"fallback": ["anthropic/claude-sonnet-5-5/medium", "openai-codex/gpt-6-luna/medium"]
			},
			"设计师": {
				"model": "anthropic/claude-opus-5-5/medium",
				"use": "视觉、前端",
				"fallback": ["openai-codex/gpt-6.1-sol/high"]
			},
			"哨兵": {
				"model": "anthropic/claude-haiku-5-5/low",
				"use": "CI、部署、长测试等待",
				"fallback": ["anthropic/claude-sonnet-5-5/low", "openai-codex/gpt-6-luna/low"]
			}
		}
	},

	// 预设：一键切换模型原子+工具+附加指令的组合，按 key 或 /preset 名字切。
	// 字段都可选：model（原子）/ tools / instructions / key；没写 key 只能 /preset。
	"presets": {
		"sonnet": { "model": "anthropic/claude-sonnet-5-5/high", "key": "alt+1" },
		"opus": { "model": "anthropic/claude-opus-5-5/high", "key": "alt+2" },
		"fable": { "model": "anthropic/claude-fable-5-1/medium", "key": "alt+3" },
		"astra": { "model": "openai-codex/gpt-6-astra/medium", "key": "alt+4" },
		"sol": { "model": "openai-codex/gpt-6.1-sol/medium", "key": "alt+5" },
		"ds": { "model": "deepseek/deepseek-flash/high", "key": "alt+6" }
	},

	// /fire-review 对抗性审查：几个审查模型并行挑毛病，全部说过才算过；
	// 没过就自动修、修完再审，循环到过或到轮数上限停下交还用户。
	// advisor：顾问模型——连续 advisorAfterFailures 轮没过时出面裁决：继续修/收窄范围/叫停。
	// reviewers：审查者，每个是独立 pi 子进程；首轮全量审，之后只盯没收拾干净的问题。
	// maxRounds：轮数硬上限。timeoutMinutes：单个审查者/顾问超时分钟数。
	// tools：审查者可用工具，只读不改文件；留 bash 是为了跑测试取证。
	// language：审查报告语言 zh/en。
	// 本节字段必须齐全；拼错字段名会直接报配置错误而不是静默忽略。
	"review": {
		"advisor": "anthropic/claude-fable-5-1/high",
		"reviewers": [
			"anthropic/claude-opus-5-5/low",
			"openai-codex/gpt-6.1-sol/low"
		],
		"maxRounds": 5,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 40,
		"tools": ["read", "grep", "find", "ls", "bash"],
		"language": "zh"
	},

	// /fire-watch 观察员：每个回合结束后用便宜模型评估增量，盯跑偏/过度工程/漏收口；
	// 模型必须是内置 provider（扩展注册的如 antigravity 在观察子会话里解析不到）。
	"watcher": {
		"enabled": false,
		"model": "openai-codex/gpt-6.1-sol/medium",
		"context": "minimal"
	}
}
