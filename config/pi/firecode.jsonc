{
	// 界面与给模型看的文字语言 zh/en；省略时跟随系统 locale。改完重启 pi。
	"language": "zh",

	// 功能开关，默认全开；要关哪个就写 false，比如 "features": { "header": false }。
	// 可选：header（启动横幅）/ statusbar（输入框边框状态）/ tools（工具行渲染）
	// / stats（/tokens 统计）/ claudeSub（Claude 订阅适配：归因与令牌换发 401 自愈）
	// / claudeFiles（发给 Claude 的图片走 Files API，每张只上传一次，不再每轮随历史重传）
	// / openaiNative（下方 openai 请求层）/ review（/fire-review）/ master（/fire-master）

	// 快捷键：加速档默认 ctrl+shift+s，要换就写 "keys": { "fast": "..." }（启动时绑定，改完需重启 pi）。
	// 改会话名用宿主的 app.session.rename 键位（默认 ctrl+r，在 keybindings.json 改），输入框里直接按。

	"openai": {
		"providers": {
			"magpie": { "textVerbosity": "low" }
		}
	},

	// 后台小模型：lineModel 写进展行（子代理与主会话）和会话名，compactionModel 写全部压缩摘要（主会话与子代理）与闲置压缩；窗口放不下的候选自动跳过，整条链失败时回到 pi 默认压缩。
	// idleCompaction：闲置超过 1 小时缓存后，下一次请求从预先算好的摘要开始，不再整段重写 15 万以上的上下文。删掉整节三项都关。
	"background": {
		"lineModel": ["claude-haiku-5-5/low", "gpt-6-luna/low"],
		"compactionModel": ["claude-haiku-5-5/high", "gpt-6-luna/high"],
		"idleCompaction": true
	},

	// 凡是指定模型的位置都写模型原子 "<模型>/<强度>"（强度取最后一段：off minimal low medium high xhigh max）；
	// 供应商可省略："claude-opus-5-5/high" 会匹配 magpie/claude/claude-opus-5-5 或 anthropic/claude-opus-5-5。
	// 写成数组就是有序候选链：前面的优先，最终报错或额度用完时同一回合换下一个并让出错的模型冷却，下一次派活再从第一个选。
	// /fire-master 角色表：角色名自定；每个角色写 model（原子或数组）+ use 适用场景。Master 只按 use 选角色，
	// 质量要求明显不同时临时调强度；一个候选都没登录的角色不会出现在角色表里。
	"master": {
		"roles": {
			"检索员": {
				"model": ["gpt-6.1-terra/high", "claude-haiku-5-5/high"],
				"use": "便宜，能做批量，不需要过强智力的工作。找事实：搜索、查文档、读日志、定位代码"
			},
			"副手": {
				"model": ["claude-sonnet-5-5/high", "gpt-6.1-terra/high"],
				"use": "能做中等智力要求，标准明确的活：照既有模式实现、批量改动、按给定标准判断等"
			},
			"工程师": {
				"model": ["claude-opus-5-5/medium", "gpt-6.1-sol/xhigh"],
				"use": "能做偏高智力要求的工作"
			}
		}
	},

	// /fire-review 对抗性审查：几个审查模型并行挑毛病，全部说过才算过；
	// 没过就自动修、修完再审，循环到过或到轮数上限停下交还用户；maxRounds 为 1 时只审一次：没过就列出发现并停下，不自动修。
	// advisor：顾问模型链——连续 advisorAfterFailures 轮没过时出面裁决：继续修/收窄范围/叫停。
	// reviewers：每项是一个审查席位的模型链，每个席位使用独立的进程内会话；首轮全量审，之后只盯没收拾干净的问题。
	// maxRounds：轮数硬上限。timeoutMinutes：单个审查者/顾问超时分钟数。
	// tools：审查者可用工具，只读不改文件；留 bash 是为了跑测试取证。
	// 本节字段必须齐全；拼错字段名会直接报配置错误而不是静默忽略。
	"review": {
		"advisor": ["claude-opus-5-5/high", "gpt-6.1-sol/high"],
		"reviewers": [["gpt-6.1-terra/low", "claude-opus-5-5/low"]],
		"maxRounds": 1,
		"advisorAfterFailures": 2,
		"timeoutMinutes": 60,
		"tools": ["read", "grep", "find", "ls", "bash"]
	}
}
