#!/usr/bin/env bash
# bbu = agent-browser + 登录态。bbu 独占 session 命名，浏览器的启动、复用、回收归 agent-browser。
# 默认（测试浏览器）：每个检出一个 Chrome for Testing，登录态按检出存取（agent-browser restore）。
# --stealth：全机一个 CloakBrowser + agent 专用 profile，每个检出一个窗口，登录实时共享。
# --mine <账户>：换成 browse（经扩展操作用户自己的浏览器），每个检出每个账户一个 browse 会话。
# --as <名字>：同一检出里再开一个会话；测试浏览器是另一份登录态，--stealth 是另一个窗口，--mine 是另一个会话。
# import <域名>...：从用户日常浏览器复制这些站点的 cookie 进共享浏览器。
# 文中 #编号 均为 vercel-labs/agent-browser 的 issue 或 PR，修复或合并后删掉对应绕行。
set -euo pipefail

DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
BBU_HOME="${BBU_HOME:-$HOME/.bbu}"
# 默认的 1h 闲置回收豁免有窗口和挂接外部浏览器的会话；显式设置后它们同样回收。
export AGENT_BROWSER_IDLE_TIMEOUT_MS="${AGENT_BROWSER_IDLE_TIMEOUT_MS:-3600000}"
# 登录态文件每个检出一份、cookie 明文；上游只在显式设置时清理过期文件。
export AGENT_BROWSER_STATE_EXPIRE_DAYS="${AGENT_BROWSER_STATE_EXPIRE_DAYS:-30}"

die() { echo "bbu: $*" >&2; exit 2; }

lane=dev as="" account=""
while :; do
  case "${1:-}" in
    --stealth) lane=stealth; shift ;;
    --mine) lane=mine account="${2:-}"; shift $(($# > 1 ? 2 : 1)) ;;
    --as) as="${2:?bbu: --as needs a name}"; shift 2 ;;
    *) break ;;
  esac
done
# restore 按 "<key>-" 前缀找登录态文件：身份名带 '-' 会读到别的身份的登录态。
[[ "$as" =~ ^[[:alnum:]_]*$ ]] || die "--as name may contain only letters, digits and '_'"
if [ "$lane" = mine ]; then
  managed="sessions are managed by bbu per checkout and --as; close with: bbu --mine <account> close"
  for arg; do
    case "$arg" in --session|--session=*|-s) die "$managed" ;; --rm) [ "${1:-}" = execute ] && die "$managed" ;; esac
  done
  [ "${1:-}" = session ] && case "${2:-}" in new|use|delete|reset) die "$managed" ;; esac
fi
for arg; do
  case "$arg" in --session|--session=*) die "session is named by bbu; use --as <name> for another session" ;; esac
done

# 同一会话被并发冷启动时，两个守护进程互删 socket、双双失败（启动无锁，#2074）。会话的准备步骤
# 在一把全机锁里串行，每次几毫秒。锁挂在 fd 9 上：守护进程会继承打开的 fd，所以锁内一切
# agent-browser 调用都经 ab_ 并关掉 fd 9，否则锁被守护进程一直占着。
mkdir -p "$BBU_HOME"
exec 9>>"$BBU_HOME/bbu.lock"
perl -MFcntl=:flock -e 'open my $f, ">&=9" or die "bbu: $!\n"; flock $f, LOCK_EX or die "bbu: $!\n"'
ab_() { agent-browser "$@" 9>&-; }

# 共享浏览器的每条命令必须带同一套启动参数：参数不同时 agent-browser 会悄悄换一个浏览器。
shared() {
  local bin profile="$BBU_HOME/profile" seed
  bin="${CLOAKBROWSER_BINARY_PATH:-$(ls -d "${CLOAKBROWSER_CACHE_DIR:-$HOME/.cloakbrowser}"/chromium-*/{Chromium.app/Contents/MacOS/Chromium,chrome} 2>/dev/null | sort -V | tail -n 1)}"
  [ -x "$bin" ] || die "CloakBrowser not found; run: npm install -g cloakbrowser && cloakbrowser install"
  # 不给种子时 CloakBrowser 每次启动随机换一台设备；同一份 cookie 配不同设备是反爬信号。种子与 profile 同生同删。
  seed="$profile/bbu-fingerprint-seed"
  [ -s "$seed" ] || { (umask 077; mkdir -p "$profile"); echo $(( (RANDOM << 15 | RANDOM) % 90000 + 10000 )) > "$seed"; }
  # CloakBrowser 的内核版本跟它自己的发布走，agent-browser 落后于稳定版的警告和升级建议对它不适用。
  AGENT_BROWSER_SESSION=bbu-stealth AGENT_BROWSER_EXECUTABLE_PATH="$bin" AGENT_BROWSER_PROFILE="$profile" \
    AGENT_BROWSER_ARGS="--fingerprint=$(< "$seed")" AGENT_BROWSER_NO_VERSION_CHECK=1 ab_ "$@"
}
# 浏览器没在跑时 get cdp-url 只报错、不启动它（0.41 起），先用 get url 启动。
shared_url() { shared get cdp-url 2>/dev/null || { shared get url >/dev/null && shared get cdp-url; }; }

if [ "${1:-}" = import ]; then
  url="$(shared_url)"
  exec 9>&-
  exec node "$DIR/helper.mjs" import "$url" "${@:2}"
fi

if [ "$lane" = mine ]; then
  # 锁内做：同一账户离线时并发的命令只开一个窗口。
  session="$(node "$DIR/helper.mjs" mine "$account" "$(ab_ session id --scope worktree --prefix bbu-mine)" "$as" 9>&-)"
  exec 9>&-
  [ "${1:-}" = close ] && exec browse session delete --session "$session"
  OPENCODE_BROWSER_SESSION="$session" exec browse "$@"
fi

if [ "$lane" = dev ]; then
  AGENT_BROWSER_SESSION="$(ab_ session id --scope worktree --prefix bbu)${as:+_$as}"
  export AGENT_BROWSER_SESSION AGENT_BROWSER_RESTORE="$AGENT_BROWSER_SESSION"
  ab() { agent-browser "$@"; }
  ab_ session info >/dev/null
else
  # 每条 --stealth 命令都经过共享会话：它启动或复用浏览器，并把 agent 的活动计入共享浏览器的闲置计时。
  url="$(shared_url)"
  AGENT_BROWSER_SESSION="$(ab_ session id --scope worktree --prefix bbu-stealth)${as:+_$as}"
  export AGENT_BROWSER_SESSION
  ab() { agent-browser --cdp "$url" --pin-tab "$@"; }
  # 每个会话占一个独立窗口：同一窗口里的后台标签被浏览器降速，动画与截图停摆。
  # 绑定是 agent-browser 记在 <socketDir>/<会话>.target 的 targetId。守护进程连着浏览器（browserLaunched）、
  # 在浏览器这次启动之后启动、窗口也还在，就直接用；否则断开旧连接，复用或新开窗口（在默认存储空间，
  # window new 每次新建隔离存储空间、登录不共享：#1425），写进绑定后带 --pin-tab 重新接入，守护进程
  # 直接挂到这个窗口。不用 tab <targetId> 切换：它把浏览器激活到前台。没连着的守护进程收到任何命令都会
  # 去连接，绑定没写好时那会多开一个空标签（#1986），所以先判断再发命令。
  info="$(ab_ --json session info)"
  socket_dir="$(sed -n 's/.*"socketDir":"\([^"]*\)".*/\1/p' <<< "$info")"
  binding="$socket_dir/$AGENT_BROWSER_SESSION.target"
  target="$(sed -n 's/.*"targetId":"\([^"]*\)".*/\1/p' "$binding" 2>/dev/null || true)"
  if [[ "$info" != *'"browserLaunched":true'* ]] || [ "$BBU_HOME/profile/DevToolsActivePort" -nt "$socket_dir/$AGENT_BROWSER_SESSION.pid" ] ||
    [ -z "$target" ] || [[ "$(ab_ --cdp "$url" --pin-tab --json tab list)" != *"$target"* ]]; then
    [[ "$info" == *'"active":true'* ]] && ab_ close >/dev/null
    target="$(node "$DIR/helper.mjs" window "$url" "$target" 9>&-)"
    (umask 077; mkdir -p "$socket_dir"; echo "{\"targetId\":\"$target\",\"pinned\":true}" > "$binding")
    ab_ --cdp "$url" --pin-tab get url >/dev/null
  fi
  # 关掉窗口里唯一的标签即关窗口；挂接会话的 close 只断开，不碰浏览器。
  [ "${1:-}" = close ] && ab_ --cdp "$url" --pin-tab tab close >/dev/null
fi
exec 9>&-
ab "$@"
