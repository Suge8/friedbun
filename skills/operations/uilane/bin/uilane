#!/usr/bin/env node
// uilane：把一段已规划好的机械界面操作交给快速决策器一步步做完，结束时把轨迹、停止原因和当前界面交回调用方。
import { parseArgs } from 'node:util';
import { CONFIG, decider, deciders, readConfig, writeConfig } from './decide.mjs';
import { parseExpect, runLane } from './lane.mjs';
import { web } from './web.mjs';
import { app } from './app.mjs';

const HELP = `uilane — run a planned, mechanical UI sequence with a fast decider, one checked step at a time

  uilane web [--login] [--as NAME] [--url URL] --goal TEXT --expect SPEC... [--data JSON] [--max-steps N]
  uilane app (--app NAME | --pid N)  --goal TEXT --expect SPEC... [--data JSON] [--max-steps N]
  uilane status | on | off

web drives this checkout's bbu session (same --login/--as as bbu; not bbu --mine; --url opens the start
address first, and is required when the session is still on a blank page); app drives a macOS app through
bcu in the background. Each step: observe, offer options built from the screen and --data, let the
decider pick one, do at most that one action, observe again. Web observations wait until the page
stops changing (up to 1.5 s; a step marked "unsettled" went ahead without that). Delete, pay, send,
publish, submit for review, quit/kill, authorize and System Settings are never offered: when the next
step is one of them, the run hands back to you with it listed in "blocked".

  --goal TEXT     the end state, not a click list ("order complete with these two items")
  --data JSON     {"name": "value"} strings the run may type or choose; nothing else is typed
  --expect SPEC   checked on a fresh observation before exit, repeatable:
                  text:<s> visible · gone:<s> not visible · url:<s> in the address (web)
                  Cover the result itself (item names, totals, the confirmation text), not the page title:
                  a title also matches a screen that was already there before the run, and leftovers from
                  earlier runs (a stale cart) can make a skipped step look done.
  --max-steps N   decisions before handing back (default 30)

Output: one JSON object. status "done" (exit 0) only when the run finished and every --expect
was met; otherwise status "handoff" (exit 1) with reason: handoff, decision_timeout, decider_error, action_failed, no_effect (the same action left the screen
unchanged), unexpected_screen, step_limit, expect_failed, observe_failed. steps is the
trajectory; screen (+ url, or the bcu state id) is where to take over. Usage and configuration errors exit 2.

Configuration: ~/.config/uilane.json plus keychain keys. uilane is on whenever a decider is
configured; "uilane off" turns it off ({"off": true}), "uilane on" back on, "uilane status" shows it.
  {"hedge": 3, "deciders": [
     {"model": "gpt-5.4-mini", "url": "https://api.openai.com/v1", "key": "uilane-gpt", "effort": "none"},
     {"model": "deepseek-flash", "url": "https://api.deepseek.com", "key": "uilane-flash",
      "extra": {"thinking": {"type": "disabled"}}}]}
Each decider is any OpenAI-compatible POST <url>/chat/completions. key is the keychain service name
(security add-generic-password -a uilane -s <key> -w <api key>); a decider without a key is skipped.
effort (optional) is sent as reasoning_effort; extra (optional) is merged into the request body.
The first decider is asked first. When it has not answered after hedge seconds (default 3), the next
is asked about the same screen in parallel, and so on; the first valid answer wins. With no answer
after 10 s the run hands back.
`;

const DEFAULT_MAX_STEPS = 30;

function die(msg) {
  process.stderr.write(`uilane: ${msg}\n`);
  process.exit(2);
}

const argv = process.argv.slice(2);
if (!argv.length || argv.some((a) => a === '-h' || a === '--help')) {
  process.stdout.write(HELP);
  process.exit(0);
}
if (['status', 'on', 'off'].includes(argv[0])) {
  if (argv.length > 1) die(`${argv[0]} takes no arguments`);
  const config = readConfig();
  if (argv[0] !== 'status') {
    if (argv[0] === 'off') config.off = true;
    else delete config.off;
    writeConfig(config);
  }
  const on = deciders(config).map((d) => d.model);
  process.stdout.write(config.off ? 'off\n' : on.length ? `on: ${on.join(', then ')}\n` : `off: no decider configured (see uilane --help)\n`);
  process.exit(0);
}
const entrants = deciders();
if (!entrants.length) die(readConfig().off ? 'off (uilane on to turn it back on)' : `off: no decider configured in ${CONFIG} and the keychain (see uilane --help)`);

let opts;
try {
  opts = parseArgs({
    args: argv,
    allowPositionals: true,
    options: {
      goal: { type: 'string' },
      data: { type: 'string', default: '{}' },
      expect: { type: 'string', multiple: true, default: [] },
      'max-steps': { type: 'string', default: String(DEFAULT_MAX_STEPS) },
      login: { type: 'boolean' },
      as: { type: 'string' },
      url: { type: 'string' },
      app: { type: 'string' },
      pid: { type: 'string' },
    },
  });
} catch (e) {
  die(e.message);
}
const { values: v, positionals } = opts;
const [kind] = positionals;
if (positionals.length !== 1 || !['web', 'app'].includes(kind)) die('first argument is web or app');
if (!v.goal) die('--goal is required');
if (!v.expect.length) die('at least one --expect is required');
if (kind === 'app' && !v.app === !v.pid) die('app needs exactly one of --app or --pid');
if (kind === 'web' && (v.app || v.pid)) die('--app/--pid belong to uilane app');
if (kind === 'app' && (v.login || v.as || v.url)) die('--login/--as/--url belong to uilane web');
const maxSteps = Number(v['max-steps']);
if (!Number.isInteger(maxSteps) || maxSteps < 1) die('--max-steps must be a positive integer');

let data;
let expect;
let surface;
let decide;
try {
  data = JSON.parse(v.data);
  if (typeof data !== 'object' || Array.isArray(data) || !data || Object.values(data).some((x) => typeof x !== 'string')) throw new Error('--data must be a JSON object of strings');
  expect = v.expect.map(parseExpect);
  if (kind === 'app' && expect.some((e) => e.kind === 'url')) throw new Error('url: expectations are for uilane web');
  surface = kind === 'web' ? web({ login: v.login, as: v.as, url: v.url }) : app({ app: v.app, pid: v.pid && Number(v.pid) });
  surface.prepare?.();
  decide = decider(entrants, (readConfig().hedge ?? 3) * 1000);
} catch (e) {
  die(e.message);
}

const result = await runLane({ surface, decide, goal: v.goal, data, expect, maxSteps });
process.stdout.write(`${JSON.stringify(result, null, 1)}\n`);
process.exit(result.status === 'done' ? 0 : 1);
